{
  "info": {
    "_postman_id": "finbank-bai3-resttemplate",
    "name": "FinBank - Bai Tap Tong Hop 3",
    "description": "Test Account Service and synchronous transfer through API Gateway.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8222"
    }
  ],
  "item": [
    {
      "name": "Account - Create 1001",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountNumber\": \"1001\",\n  \"balance\": 10000000,\n  \"customerName\": \"Nguyen Van A\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts"
          ]
        }
      }
    },
    {
      "name": "Account - Create 1002",
